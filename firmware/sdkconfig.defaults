# Lokalgrid — pinned build configuration (PROJECT.md section 5)

CONFIG_IDF_TARGET="esp32s3"

# Flash / partitions
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# PSRAM — **quad, not octal, on this unit** (2026-07-26). PROJECT.md section 1
# said "8 MB octal PSRAM"; the first real boot said
# "octal_psram: PSRAM ID read error: 0x00000000" and then abort() in a loop.
# IGNORE_NOTFOUND is the important line: a PSRAM that does not answer must
# degrade to internal RAM with a warning, never take the node down. The backlog
# buffers and tile serving (section 1) are what shrink if it is really absent.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_QUAD=y
CONFIG_SPIRAM_IGNORE_NOTFOUND=y

# Console + logs over the built-in USB-JTAG (same cable as flashing)
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# Power
CONFIG_PM_ENABLE=y
CONFIG_FREERTOS_USE_TICKLESS_IDLE=y

# BLE — NimBLE, multi-connection is the whole point. 9 is NimBLE's hard
# ceiling and therefore the effective client cap (§3, raised from 3 on
# 2026-07-23); these two lines were still carrying the old figure.
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=9

# WiFi SoftAP — the station limit is *not* a Kconfig symbol in v5.3; it is
# `wifi_config_t.ap.max_connection` at runtime (wifi_ap.c, capped at 10 by the
# API). PROJECT.md section 5 listed CONFIG_ESP_WIFI_SOFTAP_MAX_STA, which does
# not exist and was silently ignored — the build warned, which is how it was
# caught. What does need raising is the DHCP server's lease table, or the 10th
# phone associates and then gets no address.
CONFIG_LWIP_DHCPS_MAX_STATION_NUM=10

# HTTP server with WebSocket
CONFIG_HTTPD_WS_SUPPORT=y

# esp_http_server refuses to start unless max_open_sockets <= LWIP sockets - 3,
# and the default LWIP ceiling of 10 therefore caps it at 7 — below the 9-client
# cap (§3). 16 is the LWIP maximum. Found the honest way: httpd_start() returned
# ESP_ERR_INVALID_ARG on the first boot with the server in it.
CONFIG_LWIP_MAX_SOCKETS=16

# Watchdog — names the offending task rather than just rebooting (§5)
CONFIG_ESP_TASK_WDT_TIMEOUT_S=10

# The scheduler and codec get their own log level later; keep the default at
# info so the first boots are readable.
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
